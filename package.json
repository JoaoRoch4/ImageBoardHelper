{
  "name": "image-board-helper",
  "private": true,
  "description": "Development tools and the build: src/ is joined, its types erased, into image-board-helper.user.js (npm run build)",
  "scripts": {
    "build": "node tools/build.mts",
    "check": "node tools/build.mts --check && node tools/check-i18n.js && eslint && node node_modules/typescript-native/bin/tsc -p . && node node_modules/typescript-native/bin/tsc -p tools && npm run -s test:tools",
    "lint": "eslint",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p . && node node_modules/typescript-native/bin/tsc -p tools",
    "smoke": "npm run -s build && node tools/smoke.js",
    "test:gif": "npm run -s build && node tools/gif-test.js",
    "test:fav": "npm run -s build && node tools/fav-test.js",
    "test:url": "npm run -s build && node tools/url-test.js",
    "test:tools": "node --test tools/build.test.mts tools/rish.test.mts tools/phone-server.test.mts tools/video-reducer.test.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2"
  }
}
